{
  "Database": {
    "MigrateOnStartup": false
  },
  "Jwt": {
    "Issuer": "minibank",
    "Audience": "minibank-web",
    "LifetimeMinutes": 60
  },
  "Auth": {
    "RateLimitPerMinute": 10
  },
  "Limits": {
    "Default": {
      "RUB": { "PerOperation": 10000000, "Daily": 30000000 },
      "USD": { "PerOperation": 100000, "Daily": 300000 },
      "EUR": { "PerOperation": 100000, "Daily": 300000 }
    },
    "Max": {
      "RUB": { "PerOperation": 100000000, "Daily": 300000000 },
      "USD": { "PerOperation": 1000000, "Daily": 3000000 },
      "EUR": { "PerOperation": 1000000, "Daily": 3000000 }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*"
}
